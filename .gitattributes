* text=auto eol=lf
# Runtime checksum pins include the exact canonical text bytes.
app/public/assets/fixtures/*.json text eol=lf
app/public/assets/tracks/**/*.json text eol=lf
*.png binary
*.webp binary
*.glb binary
*.mp3 binary
*.ogg binary
*.woff2 binary
*.task binary
*.tflite binary
*.wasm binary
# Preserve the exact pinned upstream license bytes, including upstream spaces.
app/public/assets/fonts/*-OFL.txt whitespace=-blank-at-eol

*.blend binary
*.ttf binary

# Parallel agent branches append independent entries; keep both sides on merge.
CHANGELOG.md merge=union
AI_USAGE.md merge=union
